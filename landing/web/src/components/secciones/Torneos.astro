---
import Dato from '../Dato.astro';
import { TORNEOS } from '../../data/local';
import { WA } from '../../lib/sitio';
---
<section class="seccion torneos-seccion" id="torneos" aria-labelledby="t-torneos">
  <div class="envoltura">
    <div class="torneos-cabeza">
      <p class="torneos-label">Próximos eventos</p>
      <h2 class="titulo" id="t-torneos">Torneos</h2>
      <p class="entrada">Compite por más.</p>
    </div>
  </div>

  <div class="torneos-carril">
    <div class="torneos-pista">
      {TORNEOS.map((t, i) => (
        <article class="torneo-card">
          <div class="torneo-top">
            <span class="torneo-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="torneo-fecha-bloque">
              <span class="torneo-dia"><Dato pendiente={t.pendiente}>{t.fecha.split(' ')[0]}</Dato></span>
              <span class="torneo-mes"><Dato pendiente={t.pendiente}>{t.fecha.split(' ')[1]}</Dato></span>
            </div>
          </div>
          <h3 class="torneo-juego"><Dato pendiente={t.pendiente}>{t.juego}</Dato></h3>
          <p class="torneo-hora"><Dato pendiente={t.pendiente}>{t.hora}</Dato></p>
          <p class="torneo-premio"><Dato pendiente={t.pendiente}>{t.premio}</Dato></p>
          <a class="boton boton-secundario torneo-cta" href={WA} target="_blank" rel="noopener">Inscribirse</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .torneos-seccion { overflow: hidden; }
  .torneos-cabeza { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .torneos-label {
    font: 500 var(--t-xs)/1 var(--fm); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--acento-claro); margin-bottom: 0.75rem;
  }

  .torneos-carril {
    overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }
  .torneos-carril::-webkit-scrollbar { display: none; }

  .torneos-pista {
    display: flex; gap: 1.25rem;
    padding-inline: var(--gutter); width: max-content;
  }

  .torneo-card {
    position: relative; flex: none;
    width: min(80vw, 22rem);
    padding: 2rem;
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-radius: 0.75rem;
    display: flex; flex-direction: column;
    transition: border-color 0.3s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .torneo-card:hover { border-color: color-mix(in srgb, var(--acento) 25%, transparent); transform: translateY(-4px); }
  .torneo-card:hover .torneo-cta { background: var(--acento); color: #fff; border-color: transparent; }

  .torneo-top {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--linea);
  }
  .torneo-num {
    font: 400 clamp(3rem, 7vw, 4.5rem)/0.85 var(--fd);
    letter-spacing: -0.04em; color: rgba(255, 255, 255, 0.06);
  }
  .torneo-fecha-bloque { text-align: right; }
  .torneo-dia {
    display: block;
    font: 700 clamp(2.5rem, 5vw, 3.5rem)/1 var(--fd);
    color: var(--acento);
  }
  .torneo-mes {
    display: block;
    font: 500 var(--t-xs)/1 var(--fm); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--texto-secundario); margin-top: 0.3rem;
  }

  .torneo-juego {
    font-size: clamp(var(--t-l), 3vw, var(--t-xl)); text-transform: uppercase;
  }
  .torneo-hora {
    font: 400 var(--t-s)/1.4 var(--fm); color: var(--texto-secundario); margin-top: 0.4rem;
  }
  .torneo-premio {
    font-size: var(--t-s); color: var(--acento-claro); margin-top: 0.25rem;
  }
  .torneo-cta { margin-top: auto; padding-top: 1.5rem; align-self: flex-start; }

  @media (min-width: 64rem) {
    .torneos-carril { overflow: visible; mask-image: none; -webkit-mask-image: none; }
    .torneos-pista {
      width: auto; padding-inline: 0;
      width: min(100% - 2 * var(--gutter), var(--ancho)); margin-inline: auto;
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
    }
    .torneo-card { width: auto; }
  }
</style>
