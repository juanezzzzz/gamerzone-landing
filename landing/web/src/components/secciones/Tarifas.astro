---
// Tarifas: los 3 pasos se revelan en secuencia pinned, luego la carta y paquetes entran.
import Dato from '../Dato.astro';
import { TARIFAS, PAQUETES, PASOS } from '../../data/local';
import { whatsapp } from '../../lib/sitio';
---
<section class="tarifas-banda" id="tarifas" aria-labelledby="t-tarifas">
  <!-- Intro pinned: los 3 pasos ocupan el viewport uno a uno -->
  <div class="tarifas-pin">
    <div class="pasos-escena">
      {PASOS.map((p, i) => (
        <article class="paso-panel" data-paso={i}>
          <span class="paso-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="paso-titulo">{p.titulo}</h3>
          <p class="paso-texto"><Dato pendiente>{p.texto}</Dato></p>
        </article>
      ))}
    </div>
  </div>

  <!-- Carta + paquetes: aparecen después del pin -->
  <div class="envoltura tarifas-cuerpo">
    <div class="tarifas-cabeza">
      <h2 class="titulo" id="t-tarifas">Precios</h2>
      <p class="entrada">Paga por el tiempo que juegues. Sin sorpresas.</p>
    </div>

    <div class="carta">
      <p class="carta-rotulo">Por hora</p>
      <dl class="carta-lista cascada">
        {TARIFAS.map((t) => (
          <div class="carta-fila">
            <dt>{t.que}<span>{t.detalle}</span></dt>
            <span class="carta-puntos" aria-hidden="true"></span>
            <dd><Dato pendiente>{t.precio}</Dato></dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="paquetes cascada">
      {PAQUETES.map((p) => (
        <article class:list={['paquete', { destacado: p.destacado }]}>
          {p.destacado && <p class="paquete-sello">El que más conviene</p>}
          <h3>{p.nombre}</h3>
          <p class="paquete-precio"><Dato pendiente>{p.precio}</Dato></p>
          <p class="paquete-ahorro"><Dato pendiente>{p.ahorro}</Dato></p>
          <ul>{p.incluye.map((i) => <li><Dato pendiente>{i}</Dato></li>)}</ul>
          <a class="boton paquete-boton" href={whatsapp(`Hola GamerZone, quiero apartar el paquete «${p.nombre}». ¿Para cuándo hay disponibilidad?`)} target="_blank" rel="noopener">Apartar {p.nombre}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .tarifas-banda {
    position: relative; overflow: hidden; color: var(--texto-noche); border-top: 0;
    background: var(--noche);
  }
  .tarifas-banda + :global(.seccion) { border-top: 0; }

  /* --- Pinned step reveal --- */
  .tarifas-pin {
    position: relative; min-height: 100svh; display: grid; place-items: center;
    padding: var(--gutter);
  }
  .pasos-escena { position: relative; display: grid; place-items: center; text-align: center; }
  .paso-panel {
    grid-area: 1 / 1; opacity: 0; pointer-events: none;
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
  }
  .paso-panel[data-paso="0"] { opacity: 1; pointer-events: auto; }
  .paso-num {
    font: 400 clamp(6rem, 18vw, 14rem)/0.85 var(--fd); letter-spacing: -0.05em;
    color: var(--acento);
  }
  .paso-titulo {
    font-size: clamp(var(--t-xl), 4vw, var(--t-xxl));
    letter-spacing: -0.02em; margin-top: 0.5rem;
  }
  .paso-texto {
    color: var(--gris-noche); font-size: var(--t-m); max-width: 38ch; line-height: 1.5; margin-top: 0.5rem;
  }

  /* --- Rate card + packages --- */
  .tarifas-cuerpo {
    display: grid; gap: 2.5rem;
    padding-top: clamp(4rem, 8vw, 6rem);
    padding-bottom: clamp(6rem, 12vw, 10rem);
  }
  .tarifas-cuerpo .entrada { color: var(--gris-noche); }

  .carta {
    padding: clamp(2rem, 5vw, 3rem); border-radius: 0.75rem;
    background: var(--superficie);
    border: 1px solid var(--linea);
  }
  .carta-rotulo, .paquete-sello {
    font: 500 var(--t-xs)/1 var(--fm); letter-spacing: 0.1em; text-transform: uppercase; color: var(--acento-claro);
  }
  .carta-lista { margin: 1.25rem 0 0; }
  .carta-fila { display: flex; align-items: baseline; gap: 0.75rem; padding-block: 1.35rem; }
  .carta-fila + .carta-fila { border-top: 1px solid color-mix(in srgb, #fff 6%, transparent); }
  .carta-fila dt { font-weight: 600; letter-spacing: 0; color: var(--texto-noche); font-size: var(--t-base); }
  .carta-fila dt span { display: block; font-weight: 400; font-size: var(--t-s); color: var(--gris-noche); margin-top: 0.1rem; }
  .carta-puntos { flex: 1; min-width: 1rem; border-bottom: 2px dotted color-mix(in srgb, #fff 18%, transparent); transform: translateY(-0.35em); }
  .carta-fila dd { margin: 0; font: 400 var(--t-l)/1 var(--fd); font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--rosa); }

  .paquetes { display: grid; gap: 1.5rem; }
  .paquete {
    position: relative; display: flex; flex-direction: column;
    padding: clamp(2rem, 5vw, 3rem); border-radius: 0.75rem;
    background: var(--superficie);
    border: 1px solid var(--linea);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.3s ease;
  }
  .paquete:hover { transform: translateY(-3px); border-color: rgba(255, 255, 255, 0.16); }
  .paquete.destacado {
    background: color-mix(in srgb, var(--acento) 8%, var(--superficie-2));
    border-color: color-mix(in srgb, var(--acento) 40%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--acento) 14%, transparent),
                0 12px 40px -8px rgba(37, 99, 235, 0.22);
  }
  .paquete.destacado:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--acento) 55%, transparent); }
  .paquete h3 { font-size: var(--t-l); margin-top: 0.4rem; }
  .paquete-sello { margin-bottom: 0.2rem; }
  .paquete-precio { margin-top: 1.25rem; font: 400 clamp(2.8rem, 5.5vw, 3.8rem)/1 var(--fd); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; color: var(--texto-noche); }
  .destacado .paquete-precio { color: var(--rosa); }
  .paquete-ahorro { margin-top: 0.4rem; color: var(--violeta-claro); font-weight: 600; font-size: var(--t-s); }
  .paquete ul { list-style: none; margin: 1.5rem 0 2rem; padding: 0; display: grid; gap: 0.65rem; color: color-mix(in srgb, var(--texto-noche) 82%, transparent); font-size: var(--t-s); }
  .paquete li { position: relative; padding-left: 1.5rem; }
  .paquete li::before {
    content: ''; position: absolute; left: 0.1rem; top: 0.35em; width: 0.75rem; height: 0.42rem;
    border-left: 2px solid var(--cian); border-bottom: 2px solid var(--cian); transform: rotate(-45deg);
  }
  .paquete-boton { margin-top: auto; width: 100%; text-align: center; white-space: nowrap; }
  .destacado .paquete-boton { background: var(--acento); color: #fff; border-color: transparent; }
  .destacado .paquete-boton:hover { background: var(--acento-claro); }

  @media (min-width: 48rem) { .paquetes { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) {
    .tarifas-cuerpo { grid-template-columns: 1fr 1.25fr; gap: 2.5rem 3rem; align-items: start; }
    .tarifas-cabeza { grid-column: 1 / -1; }
  }

  /* Mobile: no pin, stack steps visibly */
  @media (max-width: 63.99rem) {
    .tarifas-pin { min-height: auto; padding-block: clamp(4rem, 8vw, 6rem); }
    .pasos-escena { display: flex; flex-direction: column; gap: 3rem; }
    .paso-panel { opacity: 1; pointer-events: auto; }
    .paso-num { font-size: clamp(3.5rem, 12vw, 6rem); }
  }
</style>
