---
import { Picture } from 'astro:assets';

const fotos = Object.fromEntries(
  Object.entries(import.meta.glob<{ default: ImageMetadata }>('../../assets/galeria/*.webp', { eager: true })).map(([k, v]) => [k, v.default]),
);

const cuadricula = [
  { foto: 'torres-rgb-completa', alt: 'Torre de PC con ventiladores RGB encendidos', span: 'grande' },
  { foto: 'jugadores-pc', alt: 'Jugador con audífonos frente a un PC', span: 'normal' },
  { foto: 'controles', alt: 'Controles de Xbox blancos y negros', span: 'normal' },
  { foto: 'futbol-sala-verde', alt: 'Partido en pantalla grande con luz verde', span: 'normal' },
  { foto: 'sala-sofa-azul', alt: 'Sala con pantalla grande frente al sofá', span: 'grande' },
  { foto: 'mostrador-lampara', alt: 'Mostrador con la lámpara Game Zone', span: 'normal' },
];
---
<section class="seccion" id="galeria" aria-labelledby="t-galeria">
  <div class="envoltura">
    <h2 class="titulo" id="t-galeria">Galería</h2>
    <p class="entrada">Grabado y fotografiado en el local.</p>
  </div>
  <div class="envoltura galeria-grid">
    {cuadricula.map(item => {
      const key = Object.keys(fotos).find(k => k.includes(item.foto));
      return key ? (
        <figure class:list={['galeria-item', item.span]}>
          <Picture src={fotos[key]} formats={['avif']} fallbackFormat="webp" widths={[400, 800]} sizes="(min-width: 64rem) 50vw, 100vw" alt={item.alt} loading="lazy" />
        </figure>
      ) : null;
    })}
  </div>
</section>

<style>
  .galeria-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .galeria-item {
    margin: 0; overflow: hidden; border-radius: 0.75rem;
    background: var(--superficie);
  }
  .galeria-item :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .galeria-item:hover :global(img) { transform: scale(1.03); }

  @media (min-width: 48rem) {
    .galeria-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 280px;
    }
    .grande { grid-column: span 2; }
  }

  @media (min-width: 64rem) {
    .galeria-grid { grid-auto-rows: 340px; gap: 1rem; }
  }
</style>
