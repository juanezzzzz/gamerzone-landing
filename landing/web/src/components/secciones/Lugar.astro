---
// Lugar: video full-bleed del local + comodidades + galería filmstrip horizontal.
import { Picture } from 'astro:assets';
import Dato from '../Dato.astro';
import Video from '../Video.astro';
import { COMODIDADES, GALERIA } from '../../data/local';

const fotos = Object.fromEntries(
  Object.entries(import.meta.glob<{ default: ImageMetadata }>('../../assets/galeria/*.webp', { eager: true })).map(([k, v]) => [k, v.default]),
);

const ICONOS = {
  aire: '<path d="M12.8 19.6A2 2 0 1 0 14 16H2"/><path d="M17.5 8a2.5 2.5 0 1 1 2 4H2"/><path d="M9.8 4.4A2 2 0 1 1 11 8H2"/>',
  wifi: '<path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/>',
  bebida: '<path d="m6 8 1.75 12.28a2 2 0 0 0 2 1.72h4.54a2 2 0 0 0 2-1.72L18 8"/><path d="M5 8h14"/><path d="M7 15a6.47 6.47 0 0 1 5 0 6.47 6.47 0 0 0 5 0"/><path d="m12 8 1-6h2"/>',
  audifonos: '<path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/>',
};
---
<section class="seccion lugar-seccion" id="lugar" aria-labelledby="t-lugar">
  <div class="envoltura">
    <p class="lugar-label">El espacio</p>
    <h2 class="titulo" id="t-lugar">El lugar</h2>
    <p class="entrada">Diseñado para jugar. No para esperar.</p>
  </div>

  <!-- Video reel full-bleed -->
  <div class="lugar-video-bleed">
    <Video clip="reel" auto etiqueta="Recorrido por GamerZone: el letrero de neón Game Room y los puestos 07 PC gamer, 11 consolas, 03 fútbol y 12 salas" />
  </div>

  <!-- Comodidades -->
  <ul class="envoltura comodidades cascada">
    {COMODIDADES.map((c) => (
      <li>
        <span class="comodidad-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONOS[c.icono]} />
        </span>
        <div><strong>{c.titulo}</strong><span><Dato pendiente={c.icono === 'wifi'}>{c.texto}</Dato></span></div>
      </li>
    ))}
  </ul>

  <!-- Galería filmstrip horizontal -->
  <div class="filmstrip-wrap">
    <ul class="filmstrip" aria-label="Fotos del local">
      {GALERIA.map((g) => (
        <li>
          <Picture src={fotos[`../../assets/galeria/${g.foto}.webp`]} formats={['avif']} fallbackFormat="webp" widths={[360, 560]} sizes="(min-width: 64rem) 22rem, 70vw" loading="lazy" alt={g.alt} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lugar-seccion { overflow: hidden; }
  .lugar-label {
    font: 500 var(--t-xs)/1 var(--fm); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--acento-claro); margin-bottom: 0.75rem;
  }

  /* Video full-bleed: rompe el contenedor */
  .lugar-video-bleed {
    width: 100vw; margin-inline: calc(50% - 50vw); aspect-ratio: 16 / 9;
    margin-top: clamp(2rem, 5vw, 3.5rem); background: #0b0d12; overflow: hidden;
    border-radius: 0;
  }
  .lugar-video-bleed :global(video) { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* Comodidades — editorial strip */
  .comodidades {
    list-style: none; margin: clamp(3rem, 6vw, 5rem) auto 0; padding: clamp(2rem, 4vw, 3rem) 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .comodidades li { display: flex; gap: 1rem; align-items: flex-start; }
  .comodidad-icono {
    flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%;
    background: color-mix(in srgb, var(--acento) 10%, transparent); color: var(--acento-claro);
  }
  .comodidad-icono svg { width: 1.2rem; height: 1.2rem; }
  .comodidades strong {
    display: block; font: 500 var(--t-xs) var(--fm);
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--texto);
  }
  .comodidades span { display: block; color: var(--gris); font-size: var(--t-s); margin-top: 0.15rem; }
  @media (min-width: 64rem) {
    .comodidades { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; }
  }

  /* Filmstrip gallery */
  .filmstrip-wrap {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }
  .filmstrip-wrap::-webkit-scrollbar { display: none; }
  .filmstrip {
    list-style: none; margin: 0; padding: 0 var(--gutter);
    display: flex; gap: 1rem; width: max-content;
  }
  .filmstrip li {
    flex: none; width: min(70vw, 22rem); aspect-ratio: 4 / 5;
    border-radius: 0.75rem; overflow: hidden; background: #0b0d12;
    box-shadow: var(--sombra); border: 1px solid rgba(255, 255, 255, 0.06);
    scroll-snap-align: center;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease, border-color 0.4s ease;
  }
  .filmstrip li:hover { transform: translateY(-5px); box-shadow: var(--sombra-elevada); border-color: rgba(255, 255, 255, 0.14); }
  .filmstrip :global(picture), .filmstrip :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .filmstrip li:hover :global(img) { transform: scale(1.06); }

  @media (max-width: 63.99rem) {
    .filmstrip-wrap { scroll-snap-type: x mandatory; }
  }
</style>
