---
// Cómo es ir a jugar: una secuencia real (escribir, llegar, pagar), por eso lleva números. Una línea se
// dibuja con el scroll uniendo los pasos (efectos/revelaciones.ts).
import Dato from '../Dato.astro';
import { PASOS } from '../../data/local';
---
<section class="seccion" id="como-funciona" aria-labelledby="t-pasos">
  <div class="envoltura">
    <h2 class="titulo" id="t-pasos">Cómo funciona</h2>
    <div class="pasos-marco">
      <span class="pasos-linea" aria-hidden="true"><span class="pasos-avance"></span></span>
      <ol class="pasos">
        {PASOS.map((p, i) => (
          <li class="paso">
            <span class="paso-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="paso-punto" aria-hidden="true"></span>
            <h3>{p.titulo}</h3>
            <p><Dato pendiente>{p.texto}</Dato></p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .pasos-marco { position: relative; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .pasos { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.5rem; }
  .paso { position: relative; padding-left: 2.75rem; }
  .paso-num {
    display: block; font: 700 clamp(4.5rem, 10vw, 7.5rem)/0.85 var(--fd); letter-spacing: -0.05em;
    color: transparent; -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.08);
    transition: color 0.6s cubic-bezier(0.16, 1, 0.3, 1), -webkit-text-stroke 0.6s ease, filter 0.6s ease;
  }
  .paso h3 { font-size: var(--t-l); margin-top: 1rem; }
  .paso p { color: var(--gris); margin-top: 0.5rem; max-width: 32ch; line-height: 1.55; }

  /* La línea: vertical en celular, horizontal en escritorio; el tramo cian avanza con el scroll */
  .pasos-linea { position: absolute; left: 0.45rem; top: 0.5rem; bottom: 0.5rem; width: 2px; background: var(--linea); }
  /* Sin script la línea queda completa (--p: 1); el script la arranca en 0 y la avanza con el scroll */
  .pasos-avance { --p: 1; position: absolute; inset: 0; background: var(--cian-oscuro); transform: scaleY(var(--p)); transform-origin: top; }
  .paso-punto {
    position: absolute; left: 0.1rem; top: 0.5rem; width: 0.9rem; height: 0.9rem; border-radius: 50%;
    background: var(--papel); border: 2px solid var(--linea);
    transition: border-color 0.5s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.5s ease, box-shadow 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .paso:global(.alcanzado) .paso-punto { border-color: var(--cian-oscuro); background: var(--cian-oscuro); box-shadow: 0 0 0 6px color-mix(in srgb, var(--cian-oscuro) 16%, transparent); transform: scale(1.15); }
  .paso:global(.alcanzado) .paso-num { color: var(--acento); -webkit-text-stroke: 0; }

  @media (min-width: 64rem) {
    .pasos { grid-template-columns: repeat(3, 1fr); gap: 3rem; padding-top: 2.5rem; }
    .paso { padding-left: 0; }
    .pasos-linea { left: 0; right: 0; top: 0.45rem; bottom: auto; width: auto; height: 2px; }
    .pasos-avance { transform: scaleX(var(--p)); transform-origin: left; }
    .paso-punto { left: 0; top: -2.5rem; }
  }
</style>
