---
// Preguntas frecuentes, con una tarjeta para escribir si la duda no está en la lista.
import Dato from '../Dato.astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { PREGUNTAS } from '../../data/local';
import { WA } from '../../lib/sitio';
---
<section class="seccion" id="preguntas" aria-labelledby="t-preguntas">
  <div class="envoltura preguntas">
    <div class="preguntas-lado">
      <h2 class="titulo" id="t-preguntas">Preguntas frecuentes</h2>
      <aside class="otra">
        <p class="otra-titulo">¿Tu pregunta no está?</p>
        <p class="otra-texto">Escríbenos y te respondemos en el día.</p>
        <a class="boton boton-principal" href={WA} target="_blank" rel="noopener"><WhatsAppIcon /> Preguntar por WhatsApp</a>
      </aside>
    </div>
    <div class="lista-preguntas cascada">
      {PREGUNTAS.map((q, i) => (
        <details name="preguntas" open={i === 0}>
          <summary>
            <span>{q.p}</span>
            <span class="signo" aria-hidden="true"></span>
          </summary>
          <p><Dato pendiente>{q.r}</Dato></p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .preguntas { display: grid; gap: 2.5rem; }
  .otra {
    margin-top: 2rem; padding: 1.5rem; border-radius: var(--radio); max-width: 24rem;
    background: var(--noche); color: var(--texto-noche);
    box-shadow: 0 30px 60px -30px rgba(16, 21, 28, 0.6);
  }
  .otra-titulo { font: 800 var(--t-m)/1.2 var(--fd); font-stretch: 115%; }
  .otra-texto { margin-top: 0.35rem; color: var(--gris-noche); font-size: var(--t-s); }
  .otra .boton { margin-top: 1.25rem; background: var(--cian); color: #04191a; }
  .otra .boton:hover { background: #8ef7f7; }

  /* Acordeón: una abierta a la vez (name), con apertura suave donde el navegador lo permite */
  .lista-preguntas { display: grid; gap: 0.75rem; interpolate-size: allow-keywords; }
  details {
    border-radius: var(--radio); background: var(--blanco); border: var(--borde);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  details[open] { border-color: color-mix(in srgb, var(--cian-oscuro) 35%, var(--linea)); box-shadow: var(--sombra); }
  details::details-content { height: 0; overflow: clip; transition: height 0.45s cubic-bezier(0.16, 1, 0.3, 1), content-visibility 0.45s allow-discrete; }
  details[open]::details-content { height: auto; }
  summary {
    list-style: none; cursor: pointer; padding: 1.15rem 1.25rem; min-height: 3rem;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-weight: 650; font-size: var(--t-base);
  }
  summary::-webkit-details-marker { display: none; }
  /* Más que gira y se vuelve menos */
  .signo { position: relative; flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: color-mix(in srgb, var(--cian-oscuro) 10%, transparent); transition: background-color 0.3s ease; }
  .signo::before, .signo::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.8rem; height: 2px; margin: -1px 0 0 -0.4rem; background: var(--cian-oscuro); transition: transform 0.35s ease, background-color 0.3s ease; }
  .signo::after { transform: rotate(90deg); }
  details[open] .signo { background: var(--cian-oscuro); }
  details[open] .signo::before, details[open] .signo::after { background: #fff; }
  details[open] .signo::after { transform: rotate(0deg); }
  details p { color: var(--gris); padding: 0 1.25rem 1.25rem; max-width: 60ch; }

  @media (min-width: 64rem) {
    .preguntas { grid-template-columns: 0.85fr 1.15fr; gap: 4rem; align-items: start; }
    .preguntas-lado { position: sticky; top: 7rem; }
  }
</style>
