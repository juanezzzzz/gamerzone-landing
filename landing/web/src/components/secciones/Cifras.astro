---
// Franja de datos después del inicio. Todo sale de data/local.ts: si cambian las estaciones, los juegos
// o el horario, las cifras cambian solas. Los números cuentan hacia arriba al aparecer (data-contar).
import { CUANTOS, DIAS_ABIERTO, CIERRE_MAS_TARDE } from '../../lib/sitio';

const cifras = [
  { valor: CUANTOS.estaciones, sufijo: '', texto: 'tipos de puesto: PC, consolas, fútbol y salas' },
  { valor: CUANTOS.juegos, sufijo: '+', texto: 'juegos instalados entre PC y consolas' },
  { valor: DIAS_ABIERTO, sufijo: '', texto: 'días a la semana abiertos' },
];
---
<section class="cifras" aria-label="GamerZone en cifras">
  <dl class="envoltura cifras-fila">
    {cifras.map((c) => (
      <div class="cifra">
        <dt>{c.texto}</dt>
        <dd><span data-contar={c.valor}>{c.valor}</span>{c.sufijo}</dd>
      </div>
    ))}
    <div class="cifra">
      <dt>hora de cierre los fines de semana</dt>
      <dd>{CIERRE_MAS_TARDE}</dd>
    </div>
  </dl>
</section>

<style>
  .cifras { padding-block: clamp(3rem, 7vw, 5rem) 0; }
  .cifras-fila { margin-block: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 1.5rem; }
  /* column-reverse pone la cifra arriba; flex-end (que aquí es arriba) alinea todas las cifras aunque los textos tengan distinto alto */
  .cifra { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.5rem; padding-top: 1.25rem; border-top: 2px solid var(--tinta); }
  .cifra dd { margin: 0; font: 850 clamp(2.5rem, 6vw, 4.25rem)/0.95 var(--fd); font-stretch: 125%; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cifra dt { font-size: var(--t-s); font-weight: 500; font-stretch: 104%; letter-spacing: 0; color: var(--gris); max-width: 22ch; }
  @media (min-width: 64rem) { .cifras-fila { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; } }
</style>
