---
import Dato from '../Dato.astro';
import { ESTACIONES, JUEGOS, HORARIO } from '../../data/local';
import { DIAS_ABIERTO } from '../../lib/sitio';

const cifras = [
  { valor: `${ESTACIONES.reduce((s, e) => s + Number(e.puesto), 0)}+`, label: 'Estaciones', pendiente: false },
  { valor: `${JUEGOS.lista.length}+`, label: 'Juegos', pendiente: JUEGOS.pendiente },
  { valor: '144 Hz', label: 'Refresh rate', pendiente: false },
  { valor: '1 Gbps', label: 'Fibra óptica', pendiente: false },
  { valor: `${DIAS_ABIERTO}`, label: 'Días a la semana', pendiente: HORARIO.pendiente },
];
---
<section class="cifras-barra" aria-label="Cifras del local">
  <div class="envoltura">
    <dl class="cifras-grilla">
      {cifras.map(c => {
        const numMatch = c.valor.match(/^(\d+)(.*)$/);
        return (
          <div class="cifra-item">
            <dd>
              <Dato pendiente={c.pendiente}>
                {numMatch
                  ? <><span data-count-to={numMatch[1]}>0</span>{numMatch[2]}</>
                  : c.valor
                }
              </Dato>
            </dd>
            <dt>{c.label}</dt>
          </div>
        );
      })}
    </dl>
  </div>
</section>

<style>
  .cifras-barra {
    position: relative; z-index: 2;
    padding-block: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--linea);
    background: var(--superficie);
  }
  .cifras-grilla {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 2.5rem 3.5rem;
    margin: 0; padding: 0;
  }
  .cifra-item { text-align: center; }
  .cifra-item dd {
    margin: 0;
    font: 700 clamp(2.5rem, 5vw, 3.5rem)/1 var(--fd);
    letter-spacing: -0.03em;
    color: var(--texto);
  }
  .cifra-item dt {
    margin-top: 0.5rem;
    font: 500 var(--t-xs)/1 var(--fm);
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--texto-secundario);
  }

  @media (min-width: 48rem) {
    .cifra-item + .cifra-item { border-left: 1px solid var(--linea); padding-left: 3.5rem; }
    .cifras-grilla { gap: 2.5rem 3.5rem; flex-wrap: nowrap; }
  }
  @media (min-width: 64rem) {
    .cifras-grilla { gap: 2.5rem 5rem; }
    .cifra-item + .cifra-item { padding-left: 5rem; }
  }
</style>
