---
// El cierre llena el viewport completo: tipografía a escala de pantalla, el control flotando.
import Dato from '../Dato.astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { NEGOCIO, HORARIO } from '../../data/local';
import { WA, FILAS_HORARIO, ICONO_PIN } from '../../lib/sitio';
---
<section class="cierre" id="cierre" aria-labelledby="t-cierre">
  <div class="cierre-fondo">
    <div class="cierre-contenido">
      <h2 class="cierre-titulo" id="t-cierre">¿Listo para jugar?</h2>
      <div class="cierre-info">
        <p class="cierre-estado" data-estado>
          <span class="estado-punto" aria-hidden="true"></span>
          <Dato pendiente={HORARIO.pendiente}><span data-estado-texto>{FILAS_HORARIO[0].dia}, {FILAS_HORARIO[0].rango}</span></Dato>
        </p>
        <p class="cierre-donde">
          <Dato pendiente={NEGOCIO.direccion.pendiente}>{NEGOCIO.direccion.texto}</Dato>, <Dato pendiente={NEGOCIO.ciudad.pendiente}>{NEGOCIO.ciudad.texto}</Dato>
        </p>
        <div class="botones">
          <a class="boton boton-principal" href={WA} target="_blank" rel="noopener"><WhatsAppIcon /> Escríbenos por WhatsApp</a>
          <a class="boton boton-secundario" href={NEGOCIO.mapa} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONO_PIN} />
            Cómo llegar
          </a>
        </div>
      </div>
      <div class="cierre-control" aria-hidden="true">
        <img src="/media/control-3d.webp" alt="" width="1120" height="896" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
  <!-- Grano de película -->
  <span class="cierre-grano" aria-hidden="true"></span>
</section>

<style>
  .cierre { position: relative; overflow: hidden; }
  .cierre-fondo {
    min-height: 100svh; display: grid; place-items: center;
    color: var(--texto-noche);
    background: var(--noche);
    padding: clamp(5rem, 12vw, 10rem) var(--gutter);
  }
  .cierre-grano {
    position: absolute; inset: -50%; pointer-events: none; opacity: 0.06;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23g)'/></svg>");
  }
  .cierre-contenido {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem;
    max-width: var(--ancho); width: 100%;
  }
  .cierre-titulo {
    font-size: clamp(3rem, 14vw, 12rem);
    line-height: 0.85; letter-spacing: -0.04em;
    color: #fff;
  }

  .cierre-estado { display: flex; align-items: center; gap: 0.6rem; font-size: clamp(var(--t-base), 2.4vw, var(--t-m)); font-weight: 600; font-variant-numeric: tabular-nums; }
  .estado-punto { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--gris-noche); flex: none; }
  .cierre-estado:global(.abierto) .estado-punto { background: #1fbf6a; box-shadow: 0 0 0 5px color-mix(in srgb, #1fbf6a 22%, transparent); }
  .cierre-estado:global(.pronto) .estado-punto { background: var(--cian); box-shadow: 0 0 0 5px color-mix(in srgb, var(--cian) 25%, transparent); }
  .cierre-donde { margin-top: 0.4rem; color: var(--gris-noche); font-size: var(--t-base); }
  .botones { margin-top: 2.25rem; }

  .cierre-control { position: relative; display: grid; place-items: center; }
  .cierre-control::before {
    content: ''; position: absolute; inset: 5% 0; pointer-events: none; filter: blur(40px);
    background: radial-gradient(50% 50% at 50% 55%, rgba(255, 255, 255, 0.03), transparent 70%);
  }
  .cierre-control img { position: relative; width: 100%; max-width: 32rem; height: auto; }

  @media (min-width: 64rem) {
    .cierre-contenido { grid-template-columns: 1.2fr 0.8fr; gap: 4rem; align-items: center; }
    .cierre-titulo { grid-column: 1 / -1; }
  }
</style>
