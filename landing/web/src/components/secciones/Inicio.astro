---
import Dato from '../Dato.astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { NEGOCIO, HORARIO } from '../../data/local';
import { WA, FILAS_HORARIO, ICONO_PIN } from '../../lib/sitio';
---
<!-- La sala a oscuras y el control que se enciende con el scroll (efectos/inicio.ts + efectos/control3d.ts) -->
<section class="inicio" id="inicio">
  <div class="envoltura inicio-grilla">
    <div class="letrero-marco" aria-hidden="true">
      <div class="letrero-movil">
        <span class="derrame"></span>
        <div class="control3d">
          <!-- Imagen fija del control en su pose inicial mientras carga el 3D; sin WebGL o con movimiento
               reducido el script la cambia por la del control encendido (efectos/inicio.ts) -->
          <img class="control3d-poster" src="/media/control-3d-inicio.webp" alt="" width="1000" height="800" fetchpriority="high" />
          <span class="control3d-sombra"></span>
        </div>
      </div>
    </div>

    <div class="inicio-texto">
      <h1 class="inicio-titulo" aria-label="¿Listo para jugar?">
        <span class="palabra" aria-hidden="true"><span class="colgado">¿</span>Listo</span>
        <span class="palabra" aria-hidden="true">para</span>
        <span class="palabra" aria-hidden="true">jugar?</span>
      </h1>
      <p class="inicio-entrada aparece">
        Sala gamer en <Dato pendiente={NEGOCIO.ciudad.pendiente}>{NEGOCIO.ciudad.texto}</Dato> con PC gamer, consolas Xbox, fútbol en pantalla grande y salas para grupos.
      </p>
      <div class="botones aparece">
        <a class="boton boton-principal" href={WA} target="_blank" rel="noopener"><WhatsAppIcon /> Escríbenos por WhatsApp</a>
        <a class="boton boton-secundario" href={NEGOCIO.mapa} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONO_PIN} />
          Cómo llegar
        </a>
      </div>
      <dl class="datos-rapidos aparece">
        <div data-estado><dt>Hoy</dt><dd><Dato pendiente={HORARIO.pendiente}><span data-estado-texto>{FILAS_HORARIO[0].dia}, {FILAS_HORARIO[0].rango}</span></Dato></dd></div>
        <div><dt>Dónde</dt><dd><Dato pendiente={NEGOCIO.direccion.pendiente}>{NEGOCIO.direccion.texto}</Dato></dd></div>
      </dl>
    </div>
  </div>
  <p class="pista" aria-hidden="true"><span></span>Desliza para encender la sala</p>
</section>

<style>
  .inicio {
    position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden;
    background: radial-gradient(60rem 40rem at 75% 40%, color-mix(in srgb, var(--cian) 9%, transparent), transparent 70%), var(--noche);
    color: var(--texto-noche);
  }
  /* Grano de película, solo en la sala */
  .inicio::after {
    content: ''; position: absolute; inset: -50%; z-index: 3; pointer-events: none; opacity: 0.06;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23g)'/></svg>");
    animation: grano 0.9s steps(4) infinite;
  }
  @keyframes grano {
    0% { transform: translate(0, 0); } 25% { transform: translate(-3%, 2%); }
    50% { transform: translate(2%, -3%); } 75% { transform: translate(-2%, -1%); } 100% { transform: translate(0, 0); }
  }
  .inicio-grilla { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding-block: 5rem 2rem; }

  .letrero-marco { position: relative; }
  .letrero-movil { position: relative; will-change: transform; }
  .derrame {
    position: absolute; inset: -30% -25%; z-index: 0; pointer-events: none; filter: blur(30px);
    background:
      radial-gradient(45% 45% at 50% 52%, color-mix(in srgb, var(--cian) 24%, transparent), transparent 70%),
      radial-gradient(28% 30% at 66% 26%, color-mix(in srgb, #ff4f5e 12%, transparent), transparent 70%),
      radial-gradient(28% 30% at 34% 26%, color-mix(in srgb, #7b4dff 10%, transparent), transparent 70%);
  }
  /* El control en 3D: el lienzo WebGL va encima de su imagen fija y la reemplaza cuando ya pintó */
  .control3d { position: relative; z-index: 1; aspect-ratio: 16 / 10; }
  .control3d-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 0.4s ease; }
  .control3d :global(.control3d-lienzo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  :global(.control3d.con-3d) .control3d-poster { opacity: 0; }
  /* Sombra de contacto: el control flota sobre una mesa oscura */
  .control3d-sombra {
    position: absolute; left: 18%; right: 18%; bottom: 2%; height: 12%; z-index: -1; pointer-events: none;
    background: radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, 0.75), transparent 70%); filter: blur(8px);
  }

  .inicio-texto { position: relative; z-index: 2; }
  .inicio-titulo { font-size: var(--t-xxl); font-weight: 850; font-stretch: 125%; line-height: 0.9; text-transform: uppercase; letter-spacing: -0.035em; }
  .palabra { display: inline-block; }
  /* Puntuación colgada: el «¿» queda fuera del margen para que las letras alineen con el texto */
  @media (min-width: 48rem) { .colgado { margin-left: -0.5em; } }
  .inicio-entrada { margin-top: 1.25rem; font-size: var(--t-m); line-height: 1.5; max-width: 34ch; color: color-mix(in srgb, var(--texto-noche) 80%, transparent); }

  /* En celular la barra fija ya lleva WhatsApp y Cómo llegar */
  .botones { display: none; }
  .boton-principal { background: var(--cian); color: #04191a; }
  .boton-principal:hover { background: #8ef7f7; }
  .boton-secundario { background: transparent; color: var(--texto-noche); border-color: color-mix(in srgb, var(--texto-noche) 28%, transparent); }
  .boton-secundario:hover { border-color: var(--cian); }

  .datos-rapidos { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 1.5rem 0 0; padding-top: 1.1rem; border-top: 1px solid color-mix(in srgb, var(--texto-noche) 12%, transparent); }
  .datos-rapidos dt { color: var(--gris-noche); }
  .datos-rapidos dd { margin: 0.2rem 0 0; font-weight: 500; font-variant-numeric: tabular-nums; }

  .pista {
    display: none; position: absolute; left: 50%; bottom: calc(3.5rem + var(--barra-movil)); translate: -50% 0; z-index: 2;
    align-items: center; gap: 0.65rem; font-size: var(--t-xs); font-stretch: 108%; letter-spacing: 0.03em; color: var(--gris-noche); white-space: nowrap;
  }
  .pista span { width: 1px; height: 2.2rem; background: linear-gradient(var(--cian), transparent); transform-origin: top; animation: pista 1.8s ease-in-out infinite; }
  @keyframes pista { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  /* Solo en escritorio: en celular el título ya está a la vista y no hace falta la invitación */
  @media (min-width: 64rem) { :global(.inicio.escena) .pista { display: flex; } }

  @media (min-width: 64rem) {
    .botones { display: flex; }
    .inicio-grilla { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 4rem; padding-block: 7rem 4rem; }
    .letrero-marco { order: 2; }
    .control3d { aspect-ratio: 5 / 4; }
  }
</style>
