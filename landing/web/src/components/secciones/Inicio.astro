---
import Dato from '../Dato.astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { NEGOCIO, HORARIO, JUEGOS } from '../../data/local';
import { WA, ICONO_PIN, CUANTOS, DIAS_ABIERTO } from '../../lib/sitio';
---
<!-- La sala a oscuras y el control que se enciende con el scroll (efectos/inicio.ts + efectos/control3d.ts) -->
<section class="inicio" id="inicio">
  <!-- Video reel del local como fondo inmersivo -->
  <div class="inicio-fondo" aria-hidden="true">
    <video class="inicio-video" muted loop playsinline preload="none" data-auto-hero>
      <source src="/media/clips/reel.webm" type='video/webm; codecs="av01.0.05M.08"' />
      <source src="/media/clips/reel.mp4" type="video/mp4" />
    </video>
    <div class="inicio-overlay"></div>
  </div>
  <div class="envoltura inicio-grilla">
    <div class="letrero-marco" aria-hidden="true">
      <div class="letrero-movil">
        <span class="derrame"></span>
        <div class="control3d">
          <!-- Imagen fija del control en su pose inicial mientras carga el 3D; sin WebGL o con movimiento
               reducido el script la cambia por la del control encendido (efectos/inicio.ts) -->
          <img class="control3d-poster" src="/media/control-3d-inicio.webp" alt="" width="1000" height="800" fetchpriority="high" />
          <span class="control3d-sombra"></span>
        </div>
      </div>
    </div>

    <div class="inicio-texto">
      <h1 class="inicio-titulo" aria-label="Juega a otro nivel">
        <span class="palabra" aria-hidden="true">Juega</span>
        <span class="palabra" aria-hidden="true">a otro</span>
        <span class="palabra" aria-hidden="true">nivel.</span>
      </h1>
      <p class="inicio-entrada aparece">
        PC Gaming. Consolas. Salas privadas. Una experiencia diseñada para jugar, competir y compartir en <Dato pendiente={NEGOCIO.ciudad.pendiente}>{NEGOCIO.ciudad.texto}</Dato>.
      </p>
      <div class="botones aparece">
        <a class="boton boton-principal" href={WA} target="_blank" rel="noopener"><WhatsAppIcon /> Escríbenos por WhatsApp</a>
        <a class="boton boton-secundario" href={NEGOCIO.mapa} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONO_PIN} />
          Cómo llegar
        </a>
      </div>
      <dl class="datos-rapidos aparece">
        <div class="cifra"><dt>tipos de puesto</dt><dd>{CUANTOS.estaciones}</dd></div>
        <div class="cifra"><dt>juegos</dt><dd><Dato pendiente={JUEGOS.pendiente}>{CUANTOS.juegos}+</Dato></dd></div>
        <div class="cifra"><dt>días a la semana</dt><dd><Dato pendiente={HORARIO.pendiente}>{DIAS_ABIERTO}</Dato></dd></div>      </dl>
    </div>
  </div>
  <p class="pista" aria-hidden="true"><span></span>Explorar experiencias</p>
</section>

<style>
  .inicio {
    position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden;
    background: var(--noche);
    color: var(--texto);
  }
  .inicio-fondo {
    position: absolute; inset: 0; z-index: 0;
  }
  .inicio-video {
    width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity 1.2s ease;
  }
  .inicio-video:global(.visible) { opacity: 1; }
  .inicio-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(8, 8, 8, 0.7) 0%,
      rgba(8, 8, 8, 0.4) 40%,
      rgba(8, 8, 8, 0.5) 70%,
      rgba(8, 8, 8, 0.85) 100%
    );
  }
  /* Grano de película, solo en la sala */
  .inicio::after {
    content: ''; position: absolute; inset: -50%; z-index: 3; pointer-events: none; opacity: 0.06;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23g)'/></svg>");
    animation: grano 0.9s steps(4) infinite;
  }
  @keyframes grano {
    0% { transform: translate(0, 0); } 25% { transform: translate(-3%, 2%); }
    50% { transform: translate(2%, -3%); } 75% { transform: translate(-2%, -1%); } 100% { transform: translate(0, 0); }
  }
  .inicio-grilla { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding-block: 6rem 3rem; }

  .letrero-marco { position: relative; }
  .letrero-movil { position: relative; will-change: transform; }
  .derrame {
    position: absolute; inset: -30% -25%; z-index: 0; pointer-events: none; filter: blur(40px);
    background: radial-gradient(45% 45% at 50% 52%, color-mix(in srgb, var(--acento) 14%, transparent), transparent 70%);
    animation: respira-derrame 6s ease-in-out infinite alternate;
  }
  @keyframes respira-derrame { to { opacity: 0.7; filter: blur(50px); } }
  /* El control en 3D: el lienzo WebGL va encima de su imagen fija y la reemplaza cuando ya pintó */
  .control3d { position: relative; z-index: 1; aspect-ratio: 16 / 10; }
  .control3d-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 0.4s ease; }
  .control3d :global(.control3d-lienzo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  :global(.control3d.con-3d) .control3d-poster { opacity: 0; }
  /* Sombra de contacto: el control flota sobre una mesa oscura */
  .control3d-sombra {
    position: absolute; left: 18%; right: 18%; bottom: 2%; height: 12%; z-index: -1; pointer-events: none;
    background: radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, 0.75), transparent 70%); filter: blur(8px);
  }

  .inicio-texto { position: relative; z-index: 2; }
  .inicio-titulo {
    font-size: clamp(3rem, 11vw, 7.5rem); line-height: 0.9; letter-spacing: -0.035em;
    color: #fff;
  }
  .palabra { display: block; }
  /* Puntuación colgada: el «¿» queda fuera del margen para que las letras alineen con el texto */
  @media (min-width: 48rem) { .colgado { margin-left: -0.5em; } }
  .inicio-entrada { margin-top: 1.25rem; font-size: var(--t-m); line-height: 1.5; max-width: 34ch; color: var(--gris-noche); }

  .botones { display: flex; }

  /* Cifras del local y la dirección, en una sola franja bajo el título */
  .datos-rapidos { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1.25rem 2.5rem; margin: 2rem 0 0; padding-top: 1.5rem; border-top: 1px solid color-mix(in srgb, var(--texto-noche) 12%, transparent); }
  .datos-rapidos dt { color: var(--gris-noche); letter-spacing: 0.06em; }
  .datos-rapidos dd { margin: 0; }
  .cifra { display: flex; flex-direction: column-reverse; }
  .cifra dd { font: 400 clamp(2rem, 3.6vw, 2.8rem)/1 var(--fd); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; color: var(--rosa); }
  .cifra dt { margin-top: 0.3rem; }

  .pista {
    display: none; position: absolute; left: 50%; bottom: calc(3.5rem + var(--barra-movil)); translate: -50% 0; z-index: 2;
    align-items: center; gap: 0.65rem; font-size: var(--t-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--gris-noche); white-space: nowrap;
  }
  .pista span { width: 1px; height: 2.2rem; background: linear-gradient(var(--cian), transparent); transform-origin: top; animation: pista 1.8s ease-in-out infinite; }
  @keyframes pista { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  /* Solo en escritorio: en celular el título ya está a la vista y no hace falta la invitación */
  @media (min-width: 64rem) { :global(.inicio.escena) .pista { display: flex; } }

  @media (min-width: 64rem) {
    .botones { display: flex; }
    .inicio-grilla { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 4rem; padding-block: 7rem 4rem; }
    .letrero-marco { order: 2; }
    .control3d { aspect-ratio: 5 / 4; }
  }
</style>

<script>
  {
    const v = document.querySelector<HTMLVideoElement>('[data-auto-hero]');
    if (v) {
      const cargar = () => {
        v.preload = 'auto';
        v.play().then(() => v.classList.add('visible')).catch(() => {});
      };
      if (document.readyState === 'complete') {
        requestIdleCallback?.(() => cargar()) ?? setTimeout(cargar, 2000);
      } else {
        window.addEventListener('load', () => {
          requestIdleCallback?.(() => cargar()) ?? setTimeout(cargar, 2000);
        }, { once: true });
      }
    }
  }
</script>
