---
// Juegos: interstitial — título grande y marquesina full-width con los nombres de los juegos.
import Dato from '../Dato.astro';
import { JUEGOS } from '../../data/local';

const corte = Math.ceil(JUEGOS.lista.length / 2);
const mitades = [JUEGOS.lista.slice(0, corte), JUEGOS.lista.slice(corte)];
---
<section class="juegos-inter" id="juegos" aria-labelledby="t-juegos">
  <div class="envoltura juegos-cabeza">
    <h2 class="juegos-titulo" id="t-juegos">Biblioteca</h2>
    <p class="juegos-sub"><Dato pendiente={JUEGOS.pendiente}>{JUEGOS.lista.length}+ títulos listos para jugar.</Dato></p>
  </div>
  <div class="marquesina" aria-hidden="true">
    {[mitades[0], mitades[1]].map((fila, n) => (
      <div class:list={['marquesina-fila', { inversa: n === 1 }]}>
        {[0, 1].map(() => (
          <span class="marquesina-grupo">{fila.map((j) => <span class="marquesina-juego">{j}</span>)}</span>
        ))}
      </div>
    ))}
  </div>
  <ul class="sr-only">{JUEGOS.lista.map((j) => <li>{j}</li>)}</ul>
</section>

<style>
  .juegos-inter {
    padding-block: clamp(4rem, 8vw, 6rem);
    overflow: hidden;
  }
  .juegos-cabeza { text-align: center; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .juegos-titulo {
    font: 400 var(--t-xxl)/0.9 var(--fd); letter-spacing: -0.035em;
    max-width: none;
    color: #fff;
  }
  .juegos-sub { color: var(--gris); font-size: var(--t-m); margin-top: 0.75rem; }

  .marquesina { display: grid; gap: 0.35rem; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .marquesina-fila { display: flex; width: max-content; animation: desliza 60s linear infinite; }
  .marquesina-fila.inversa { animation-direction: reverse; animation-duration: 70s; }
  .marquesina-grupo { display: flex; }
  .marquesina-juego {
    display: flex; align-items: center; gap: 0.6em; padding-right: 0.6em; white-space: nowrap;
    font: 400 clamp(3rem, 9vw, 7rem)/1.05 var(--fd); letter-spacing: -0.03em;
    color: transparent; -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.08);
  }
  .marquesina-juego::after { content: ''; width: 0.18em; height: 0.18em; border-radius: 50%; background: var(--acento); }
  .inversa .marquesina-juego { color: rgba(255, 255, 255, 0.88); -webkit-text-stroke: 0; }
  .marquesina:hover .marquesina-fila { animation-play-state: paused; }
  @keyframes desliza { to { transform: translateX(-50%); } }
</style>
