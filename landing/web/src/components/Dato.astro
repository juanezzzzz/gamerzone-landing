---
// Un dato del negocio. `pendiente` documenta en el código que el dato aún es de referencia (ver
// landing/DATOS-DE-REFERENCIA.md); en la página se ve igual que cualquier otro texto.
interface Props { pendiente?: boolean; tag?: 'span' | 'p' | 'strong' }
const { pendiente = false, tag: Tag = 'span' } = Astro.props;
---
<Tag data-referencia={pendiente ? '' : undefined}><slot /></Tag>
